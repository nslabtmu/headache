<script>
let audioCtx;
let masterGain;
let reverbNode;
let mediaStreamDest;
let mediaRecorder;
let recordedChunks = [];
let timerInterval;
let totalSeconds = 20 * 60; // 20 分鐘
let isRunning = false;
let musicScheduleTimeout;

function log(text) {
  const box = document.getElementById('logBox');
  box.innerHTML += `<div>> ${text}</div>`;
  box.scrollTop = box.scrollHeight;
}

function updateTimerDisplay(sec) {
  const m = Math.floor(sec / 60).toString().padStart(2, '0');
  const s = (sec % 60).toString().padStart(2, '0');
  document.getElementById('timer').innerText = `${m}:${s}`;
}

function m2f(note) {
  return 440 * Math.pow(2, (note - 69) / 12);
}

// 超柔和助眠長混響 (Sleep Space Impulse Response)
function createReverbBuffer() {
  const length = audioCtx.sampleRate * 4.0; // 4.0秒長尾韻
  const buffer = audioCtx.createBuffer(2, length, audioCtx.sampleRate);
  for (let c = 0; c < 2; c++) {
    const data = buffer.getChannelData(c);
    for (let i = 0; i < length; i++) {
      data[i] = (Math.random() * 2 - 1) * Math.pow(1 - i / length, 3.0);
    }
  }
  return buffer;
}

// ---------------- 柔和純鋼琴音色合成器 ----------------
function playSleepPianoNote(noteNumber, duration = 5.0, velocity = 0.3, pan = 0) {
  if (!isRunning) return;

  const now = audioCtx.currentTime;
  const freq = m2f(noteNumber);

  // 雙振盪器（基音 + 微暖和聲，避開尖銳高頻）
  const osc1 = audioCtx.createOscillator();
  const osc2 = audioCtx.createOscillator();

  osc1.type = 'sine';
  osc2.type = 'triangle';

  osc1.frequency.value = freq;
  osc2.frequency.value = freq * 2; // 微弱第二倍音

  const noteGain = audioCtx.createGain();
  const peakVolume = velocity * 0.2; // 降低整體音量，更適合睡眠

  noteGain.gain.setValueAtTime(0, now);
  noteGain.gain.linearRampToValueAtTime(peakVolume, now + 0.04); // 極柔和的觸鍵 (Attack)
  noteGain.gain.exponentialRampToValueAtTime(peakVolume * 0.5, now + 0.8);
  noteGain.gain.exponentialRampToValueAtTime(0.00001, now + duration);

  // 睡眠專用深層低通濾波 (Damped Warm Filter)
  const filter = audioCtx.createBiquadFilter();
  filter.type = 'lowpass';
  filter.frequency.setValueAtTime(Math.min(freq * 2.5, 3500), now); // 濾除高頻雜音
  filter.frequency.exponentialRampToValueAtTime(Math.max(freq * 1.1, 150), now + duration);

  const panner = audioCtx.createStereoPanner();
  panner.pan.value = pan;

  osc1.connect(noteGain);
  osc2.connect(noteGain);
  noteGain.connect(filter);
  filter.connect(panner);

  const dryGain = audioCtx.createGain();
  dryGain.gain.value = 0.5;
  panner.connect(dryGain);
  dryGain.connect(masterGain);

  if (reverbNode) {
    const wetGain = audioCtx.createGain();
    wetGain.gain.value = 0.5; // 大比例混響营造夜間深邃感
    panner.connect(wetGain);
    wetGain.connect(reverbNode);
  }

  osc1.start(now);
  osc2.start(now);

  osc1.stop(now + duration + 0.1);
  osc2.stop(now + duration + 0.1);
}

// ---------------- 助眠專用 U-Shape 和弦與旋律庫 ----------------
const SLEEP_CHORDS_PHASE1 = [
  [36, 48, 55, 60, 64], // C maj9 (深沉安定)
  [45, 52, 57, 60, 64], // Am7
  [41, 48, 53, 57, 60]  // F maj7
];

const SLEEP_CHORDS_PHASE2 = [
  [43, 50, 55, 59, 62, 67], // G add9 (溫暖撫慰)
  [45, 52, 57, 62, 65],     // Am9
  [41, 48, 55, 60, 64]      // F maj9 (心靈共鳴)
];

const SLEEP_CHORDS_PHASE3 = [
  [36, 43, 48, 55], // C5 Deep (極低頻安定)
  [41, 48, 53, 57], // F maj7 Low
  [33, 40, 45, 52]  // A low
];

const MELODY_SLEEP = [55, 57, 60, 62, 64, 67, 69, 72]; // 柔和不刺耳的音符

function playSleepUShapeMusic() {
  if (!isRunning) return;

  const elapsedTime = totalSeconds - Math.floor((timerInterval ? remainingTimeSec : 1200));
  let currentTempo = 4500; // 節拍時間 (ms)
  let currentChordList = SLEEP_CHORDS_PHASE1;
  let phaseName = "";
  let masterVolFactor = 1.0;

  // U-Shape 助眠三階段控制
  if (elapsedTime < 360) {
    // 0 ~ 6 min：平緩引導 (Wind Down) - 約 55 BPM 節奏
    phaseName = "🌌 階段 1：平緩引導 ( 呼吸同步與卸下焦慮 )";
    document.getElementById('phaseBadge').innerText = phaseName;
    document.getElementById('phaseBadge').style.borderColor = "#818CF8";
    document.getElementById('phaseBadge').style.color = "#C7D2FE";
    currentTempo = 3800 + (elapsedTime / 360) * 800;
    currentChordList = SLEEP_CHORDS_PHASE1;
    masterVolFactor = 0.9;
  } else if (elapsedTime >= 360 && elapsedTime < 840) {
    // 6 ~ 14 min：暖心撫慰 (Warm Comfort) - U型底部：和聲轉趨溫暖豐富，撫平潛意識
    phaseName = "🌙 階段 2：暖心撫慰 ( 深層和聲與心靈共鳴 )";
    document.getElementById('phaseBadge').innerText = phaseName;
    document.getElementById('phaseBadge').style.borderColor = "#A7F3D0";
    document.getElementById('phaseBadge').style.color = "#6EE7B7";
    currentTempo = 4600 + Math.sin((elapsedTime - 360) / 480 * Math.PI) * 600; 
    currentChordList = SLEEP_CHORDS_PHASE2;
    masterVolFactor = 1.0; // 稍微增加和聲豐滿度，但不增加音量刺激
  } else {
    // 14 ~ 20 min：沉睡降速 (Deep Delta Drift) - 節奏極緩，引導腦波進入慢波睡眠
    phaseName = "💤 階段 3：沉睡降速 ( 進入 Δ 腦波慢波睡眠 )";
    document.getElementById('phaseBadge').innerText = phaseName;
    document.getElementById('phaseBadge').style.borderColor = "#C084FC";
    document.getElementById('phaseBadge').style.color = "#E9D5FF";
    currentTempo = 5200 + ((elapsedTime - 840) / 360) * 3500; // 速度驟降至極慢 (約 30~40 BPM)
    currentChordList = SLEEP_CHORDS_PHASE3;
    masterVolFactor = Math.max(0.3, 1.0 - ((elapsedTime - 840) / 360) * 0.7); // 漸隱衰減
  }

  // 選取低頻和弦
  const chord = currentChordList[Math.floor(Math.random() * currentChordList.length)];
  
  // 彈奏伴奏和弦 (低音慢琶音)
  chord.forEach((note, idx) => {
    const delay = idx * 0.45; 
    const pan = (Math.random() * 0.6) - 0.3;
    const vel = (0.2 + (idx === 0 ? 0.1 : 0)) * masterVolFactor;
    setTimeout(() => {
      playSleepPianoNote(note, 6.0, vel, pan);
    }, delay * 1000);
  });

  // 偶爾加入極柔和的單聲部高音旋律
  if (Math.random() > 0.4 && elapsedTime < 1000) {
    const melodyNote = MELODY_SLEEP[Math.floor(Math.random() * MELODY_SLEEP.length)];
    const melodyDelay = 2.0 + Math.random() * 1.5;
    const pan = (Math.random() * 0.8) - 0.4;
    setTimeout(() => {
      playSleepPianoNote(melodyNote, 5.0, 0.18 * masterVolFactor, pan);
    }, melodyDelay * 1000);
  }

  musicScheduleTimeout = setTimeout(playSleepUShapeMusic, currentTempo);
}

let remainingTimeSec = totalSeconds;

function downloadAudio() {
  const blob = new Blob(recordedChunks, { type: 'audio/webm' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.style.display = 'none';
  a.href = url;
  a.download = `piano_insomnia_ushape_20min_${Date.now()}.webm`;
  document.body.appendChild(a);
  a.click();
  setTimeout(() => {
    document.body.removeChild(a);
    window.URL.revokeObjectURL(url);
  }, 100);
}

function stopProcess() {
  if (!isRunning) return;
  isRunning = false;
  clearInterval(timerInterval);
  clearTimeout(musicScheduleTimeout);
  
  log("🛑 20分鐘助眠聲景結束，鋼琴聲漸隱至極靜...");
  
  masterGain.gain.linearRampToValueAtTime(0.00001, audioCtx.currentTime + 5.0);
  
  setTimeout(() => {
    if (mediaRecorder && mediaRecorder.state !== 'inactive') {
      mediaRecorder.stop();
    }
    document.getElementById('startBtn').disabled = false;
    document.getElementById('stopBtn').disabled = true;
    document.getElementById('phaseBadge').innerText = "睡眠引導完畢";
    log("💾 助眠音訊檔已自動下載 (piano_insomnia_ushape_20min.webm)。");
  }, 5000);
}

document.getElementById('startBtn').addEventListener('click', () => {
  audioCtx = new (window.AudioContext || window.webkitAudioContext)();
  
  masterGain = audioCtx.createGain();
  masterGain.gain.setValueAtTime(0.8, audioCtx.currentTime);
  masterGain.connect(audioCtx.destination);

  reverbNode = audioCtx.createConvolver();
  reverbNode.buffer = createReverbBuffer();
  reverbNode.connect(masterGain);

  mediaStreamDest = audioCtx.createMediaStreamDestination();
  masterGain.connect(mediaStreamDest);

  recordedChunks = [];
  mediaRecorder = new MediaRecorder(mediaStreamDest.stream);
  mediaRecorder.ondataavailable = (e) => {
    if (e.data.size > 0) recordedChunks.push(e.data);
  };
  mediaRecorder.onstop = downloadAudio;
  mediaRecorder.start();

  isRunning = true;
  remainingTimeSec = totalSeconds;
  document.getElementById('startBtn').disabled = true;
  document.getElementById('stopBtn').disabled = false;

  log("🎙️ 助眠純鋼琴合成與錄音已啟動...");
  log("🌙 第一階段 (0 ~ 6 分鐘)：平緩引導，穩定呼吸節奏...");
  
  playSleepUShapeMusic();
  updateTimerDisplay(remainingTimeSec);
  
  timerInterval = setInterval(() => {
    remainingTimeSec--;
    updateTimerDisplay(remainingTimeSec);

    if (remainingTimeSec === 840) {
      log("🌙 第二階段 (6 ~ 14 分鐘)：進入暖心撫慰和聲，放鬆深層神經...");
    } else if (remainingTimeSec === 360) {
      log("💤 第三階段 (14 ~ 20 分鐘)：進入極緩降速段，引導腦波進入深度 Delta 睡眠...");
    }

    if (remainingTimeSec <= 0) {
      stopProcess();
    }
  }, 1000);
});

document.getElementById('stopBtn').addEventListener('click', stopProcess);
</script>

</body>
</html>
"""

